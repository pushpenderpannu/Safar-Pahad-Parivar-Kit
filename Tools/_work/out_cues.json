{"spp":1,"cues":[{"a":37.19,"b":43.35,"text":"धीरे धीरे मैदान पीछे छूटने लगे और गाड़ी पहाड़ों की तरफ़ मुड़ गई","w":[[37.78,38.06,1],[38.07,38.61,0],[38.61,39.47,1],[39.47,39.77,0],[39.77,40.2,0],[40.21,40.47,0],[40.47,41.47,0],[41.47,41.91,0],[41.91,42.64,0],[42.65,42.73,0],[42.73,43.09,0],[43.09,43.2,0],[43.21,43.35,0]]},{"a":48.37,"b":55.77,"text":"हरे भरे सुंदर रास्ते, नीला आसमां,\nसफ़ेद बादल, किसका मन न मोह ले ये?","w":[[49.19,49.71,0],[49.71,50.01,0],[50.01,50.33,0],[50.33,50.79,0],[50.93,51.8,1],[51.81,52.35,0],[52.43,53.51,0],[53.51,53.9,0],[54.03,54.87,0],[54.87,55.08,1],[55.09,55.19,0],[55.19,55.4,0],[55.41,55.59,0],[55.59,55.77,0]]},{"a":61.65,"b":65.17,"text":"पहाड़ का ख़ाली रास्ता मन भर देता है","w":[[61.75,62.31,0],[62.31,62.53,0],[62.53,62.97,0],[62.97,63.29,0],[63.63,64.07,1],[64.07,64.51,0],[64.51,64.95,0],[64.95,65.17,0]]}]}