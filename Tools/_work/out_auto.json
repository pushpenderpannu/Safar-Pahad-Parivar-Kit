{"spp":1,"cues":[{"a":37.19,"b":43.33,"text":"धीरे धीरे मैदान पीछे छूकने लगे और काड़ी पहाड़ों के तरफ मुड़ गई","w":[[37.19,38.07,1],[38.07,38.61,0],[38.61,39.47,1],[39.47,39.77,0],[39.77,40.21,0],[40.21,40.47,0],[40.47,41.47,0],[41.47,41.91,0],[41.91,42.65,0],[42.65,42.75,0],[42.75,42.93,0],[42.93,43.21,0],[43.21,43.33,0]]},{"a":48.37,"b":55.75,"text":"हरे भरे सुन्दर आस्ते, नीला आस्मा, सफेद पातल, किसका मन नमोले ये?","w":[[48.37,49.71,0],[49.71,50.01,1],[50.01,50.35,0],[50.35,50.75,0],[50.93,51.81,0],[51.81,52.23,0],[52.35,53.53,0],[53.53,53.93,0],[54.01,54.89,0],[54.89,55.09,1],[55.09,55.49,0],[55.49,55.75,0]]},{"a":61.65,"b":65.17,"text":"पहाड का खाली रस्ता मन भर देता है","w":[[61.65,62.17,0],[62.17,62.35,0],[62.35,62.63,0],[62.63,63.13,0],[63.13,64.41,1],[64.41,64.61,0],[64.61,64.95,0],[64.95,65.17,0]]},{"a":65.73,"b":69.61,"text":"और तूर बेटा पहाड भी मन के तो पांस ही लगता है","w":[[65.73,66.25,0],[66.25,66.51,0],[66.51,66.77,0],[66.77,67.31,0],[67.31,67.57,0],[67.57,68.37,1],[68.37,68.55,0],[68.55,68.67,0],[68.67,69.01,0],[69.01,69.13,0],[69.13,69.37,0],[69.37,69.61,0]]},{"a":76.5,"b":79.12,"text":"यहां रुककर हमने नदी को देखा","w":[[76.5,77.54,0],[77.54,78.02,0],[78.02,78.34,0],[78.34,78.58,0],[78.58,78.76,0],[78.76,79.12,0]]},{"a":79.12,"b":81.26,"text":"उसकी अट्खेलियों को देखा","w":[[79.12,80.06,0],[80.06,80.66,0],[80.66,80.78,0],[80.78,81.26,0]]},{"a":81.26,"b":83.34,"text":"मुझे पहाड को देखा","w":[[81.26,82.3,0],[82.3,82.74,0],[82.74,82.94,0],[82.94,83.34,0]]},{"a":83.34,"b":85.5,"text":"कुछ तस्वीरों को देखा","w":[[83.34,84.32,0],[84.32,84.96,1],[84.96,85.04,0],[85.04,85.5,0]]},{"a":85.5,"b":87.76,"text":"और फिर रस्ते पर चल दिये","w":[[85.5,86.22,0],[86.22,86.56,0],[86.56,87.08,0],[87.08,87.3,0],[87.3,87.56,0],[87.56,87.76,0]]}]}