{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "spp-chapter",
  "version": "1.0.0",
  "name": "SPP Chapter",
  "description": "Chapter card: big chapter number, Hindi + English chapter name, day / route line and a trail showing chapter X of N. 'Chapters - Number + YouTube List' numbers them and writes the YouTube chapter list.",
  "author": {
    "name": "Safar Pahad Parivar"
  },
  "main": "SPP-Chapter.js",
  "supportsRealTime": false,
  "supportsNonRealTime": true,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "number": {
        "type": "integer",
        "title": "Chapter number",
        "minimum": 0,
        "maximum": 99,
        "default": 2
      },
      "total": {
        "type": "integer",
        "title": "Total chapters (0 = hide the trail)",
        "minimum": 0,
        "maximum": 30,
        "default": 5
      },
      "titleHi": {
        "type": "string",
        "title": "Chapter name (Hindi)",
        "default": "दारमा घाटी की ओर"
      },
      "titleEn": {
        "type": "string",
        "title": "Chapter name (English, blank = hide)",
        "default": "INTO THE DARMA VALLEY"
      },
      "meta": {
        "type": "string",
        "title": "Day / route line (blank = hide)",
        "default": "दिन 2 · धारचूला → दुग्तू"
      },
      "labelHi": {
        "type": "string",
        "title": "Label (Hindi)",
        "default": "अध्याय"
      },
      "labelEn": {
        "type": "string",
        "title": "Label (English)",
        "default": "CHAPTER"
      },
      "hindiDigits": {
        "type": "boolean",
        "title": "Hindi digits (२ instead of 2)",
        "default": false
      },
      "position": {
        "type": "string",
        "title": "Position: centre / bottom-left / top-left",
        "default": "centre"
      },
      "backdrop": {
        "type": "boolean",
        "title": "Darken Background",
        "default": false
      },
      "scale": {
        "type": "number",
        "title": "Size",
        "minimum": 0.3,
        "maximum": 2.0,
        "default": 1.0
      },
      "outAt": {
        "type": "number",
        "title": "Animate Out At (s, 0 = end)",
        "minimum": 0,
        "maximum": 5,
        "default": 0
      },
      "accentColor": {
        "type": "string",
        "title": "Accent Colour",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "default": "#f4b03e"
      },
      "rolling": {
        "type": "boolean",
        "title": "Rolling-dial number",
        "default": true
      }
    }
  },
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      },
      "frameRate": {
        "ideal": 30
      },
      "accessToPublicInternet": false
    }
  ],
  "v_bmd": {
    "duration": 5
  }
}