{
	Tools = ordered() {
		SPP_PeakLabel = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			CustomData = {
				HelpPage = "Safar Pahad Parivar - Peak Label. Label Point = where your line ends (connect it to a Tracker's Offset Position). Animate Reveal 0 -> 1 to bring it in."
			},
			Inputs = ordered() {
				HindiName = InstanceInput {
					SourceOp = "NameText",
					Source = "StyledText",
					Name = "Hindi Name",
				},
				EnglishLine = InstanceInput {
					SourceOp = "SubText",
					Source = "StyledText",
					Name = "English + Height",
				},
				LabelPoint = InstanceInput {
					SourceOp = "Place",
					Source = "Center",
					Name = "Label Point",
					DefaultX = 0.5,
					DefaultY = 0.5,
				},
				LabelSide = InstanceInput {
					SourceOp = "Place",
					Source = "LabelSide",
					Default = 0,
				},
				Reveal = InstanceInput {
					SourceOp = "Place",
					Source = "Reveal",
					Default = 1,
				},
				Size = InstanceInput {
					SourceOp = "Place",
					Source = "Size",
					Default = 1,
				},
				AccentRed = InstanceInput {
					SourceOp = "SubText",
					Source = "Red1",
					Name = "Accent Colour",
					ControlGroup = 7,
					Default = 0.957,
				},
				AccentGreen = InstanceInput {
					SourceOp = "SubText",
					Source = "Green1",
					ControlGroup = 7,
					Default = 0.69,
				},
				AccentBlue = InstanceInput {
					SourceOp = "SubText",
					Source = "Blue1",
					ControlGroup = 7,
					Default = 0.243,
				},
				ShowTick = InstanceInput {
					SourceOp = "Place",
					Source = "ShowTick",
					Default = 1,
				},
				Shadow = InstanceInput {
					SourceOp = "Place",
					Source = "ShadowAmount",
					Default = 0.7,
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Place",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Tick = sRectangle {
					CtrlWZoom = false,
					Inputs = {
						["Translate.X"] = Input { Expression = "iif(Place.LabelSide==1,-1,1)*Place.ShowTick*0.013*min(1,max(0,Place.Reveal/0.35))/2" },
						Width = Input { Expression = "Place.ShowTick*0.013*min(1,max(0,Place.Reveal/0.35))" },
						Height = Input { Value = 0.0028 },
						Red = Input { Expression = "SubText.Red1" },
						Green = Input { Expression = "SubText.Green1" },
						Blue = Input { Expression = "SubText.Blue1" },
					},
					ViewInfo = OperatorInfo { Pos = { -330, 10 } },
				},
				TickRender = sRender {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "Tick", Source = "Output" },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 10 } },
				},
				NameText = TextPlus {
					CtrlWZoom = false,
					Inputs = {
						Center = Input { Expression = "Point(0.5+iif(Place.LabelSide==1,-1,1)*0.019, 0.5+0.006)" },
						HorizontalLeftCenterRight = Input { Expression = "iif(Place.LabelSide==1,1,-1)" },
						HorizontalJustificationNew = Input { Expression = "iif(Place.LabelSide==1,2,0)" },
						VerticalTopCenterBottom = Input { Value = 1 },
						StyledText = Input { Value = "पंचाचूली II" },
						Font = Input { Value = "Mukta" },
						Style = Input { Value = "ExtraBold" },
						Size = Input { Value = 0.042 },
						Red1 = Input { Value = 0.961 },
						Green1 = Input { Value = 0.973 },
						Blue1 = Input { Value = 0.988 },
						Enabled3 = Input { Value = 1 },
						Red3 = Input { Value = 0 },
						Green3 = Input { Value = 0 },
						Blue3 = Input { Value = 0 },
						Opacity3 = Input { Expression = "Place.ShadowAmount" },
						SoftnessX3 = Input { Value = 6 },
						SoftnessY3 = Input { Value = 6 },
						Offset3 = Input { Value = { 0.0012, -0.0018 } },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 60 } },
				},
				SubText = TextPlus {
					CtrlWZoom = false,
					Inputs = {
						Center = Input { Expression = "Point(0.5+iif(Place.LabelSide==1,-1,1)*0.019, 0.5-0.011)" },
						HorizontalLeftCenterRight = Input { Expression = "iif(Place.LabelSide==1,1,-1)" },
						HorizontalJustificationNew = Input { Expression = "iif(Place.LabelSide==1,2,0)" },
						VerticalTopCenterBottom = Input { Value = -1 },
						StyledText = Input { Value = "PANCHACHULI II  ·  6,904 m" },
						Font = Input { Value = "Poppins" },
						Style = Input { Value = "SemiBold" },
						Size = Input { Value = 0.0155 },
						CharacterSpacing = Input { Value = 1.04 },
						Red1 = Input { Value = 0.957 },
						Green1 = Input { Value = 0.69 },
						Blue1 = Input { Value = 0.243 },
						Enabled3 = Input { Value = 1 },
						Red3 = Input { Value = 0 },
						Green3 = Input { Value = 0 },
						Blue3 = Input { Value = 0 },
						Opacity3 = Input { Expression = "Place.ShadowAmount" },
						SoftnessX3 = Input { Value = 5 },
						SoftnessY3 = Input { Value = 5 },
						Offset3 = Input { Value = { 0.0008, -0.0012 } },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 110 } },
				},
				NameOver = Merge {
					CtrlWZoom = false,
					Inputs = {
						Blend = Input { Expression = "min(1,max(0,(Place.Reveal-0.3)/0.45))" },
						Background = Input { SourceOp = "TickRender", Source = "Output" },
						Foreground = Input { SourceOp = "NameText", Source = "Output" },
						PerformDepthMerge = Input { Value = 0 },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 10 } },
				},
				SubOver = Merge {
					CtrlWZoom = false,
					Inputs = {
						Blend = Input { Expression = "min(1,max(0,(Place.Reveal-0.45)/0.55))" },
						Background = Input { SourceOp = "NameOver", Source = "Output" },
						Foreground = Input { SourceOp = "SubText", Source = "Output" },
						PerformDepthMerge = Input { Value = 0 },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 10 } },
				},
				Place = Transform {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "SubOver", Source = "Output" },
						Center = Input { Value = { 0.5, 0.5 } },
						LabelSide = Input { Value = 0 },
						Reveal = Input { Value = 1 },
						ShowTick = Input { Value = 1 },
						ShadowAmount = Input { Value = 0.7 },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 10 } },
					UserControls = ordered() {
						LabelSide = {
							{ CCS_AddString = "Right of the point" },
							{ CCS_AddString = "Left of the point" },
							CC_LabelPosition = "Horizontal",
							INPID_InputControl = "ComboControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Label Side",
							INP_Integer = true,
							INP_Default = 0,
							ICS_ControlPage = "Controls",
						},
						Reveal = {
							LINKS_Name = "Reveal (animate 0 to 1)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							INP_Default = 1,
							ICS_ControlPage = "Controls",
						},
						ShowTick = {
							LINKS_Name = "Yellow Tick",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							INP_Default = 1,
							ICS_ControlPage = "Controls",
						},
						ShadowAmount = {
							LINKS_Name = "Text Shadow",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							INP_Default = 0.7,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "SPP_PeakLabel",
}
